generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  cars      Car[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Car {
  id          String          @id @default(cuid())
  name        String
  make        String
  model       String
  year        Int
  vin         String?         @unique
  licensePlate String?
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  telemetry   TelemetryLog[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("cars")
}

model TelemetryLog {
  id            String   @id @default(cuid())
  carId         String
  car           Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  speed         Float?
  rpm           Float?
  throttle      Float?
  brake         Float?
  steeringAngle Float?
  fuelLevel     Float?
  engineTemp    Float?
  latitude      Float?
  longitude     Float?
  recordedAt    DateTime @default(now())

  @@index([carId, recordedAt])
  @@map("telemetry_logs")
}
